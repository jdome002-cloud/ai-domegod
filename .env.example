# Copy these into the host environment (e.g. Render dashboard). Do not commit a real key.
# Keys are read from the environment only — never from the client, never logged.

# Default provider is Groq (free). Get a key at https://console.groq.com
AI_PROVIDER=groq
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-120b (current Groq recommended free model).
GROQ_MODEL=openai/gpt-oss-120b

# Optional OpenAI fallback: used only if GROQ_API_KEY is unset AND AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=3000
NODE_ENV=production
